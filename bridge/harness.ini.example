# Bridge model profiles. NO SECRETS HERE — this file names the environment
# variable that holds the key, never the key itself.
#
# Copy to bridge/harness.ini to activate. Resolution order:
#   built-in defaults < this file < DEEPSEEK_* environment < CLI arguments

[model]
default=opencode-go

# Reply generator, conversation memory and stop sequence. HARNESS_GENERATOR /
# HARNESS_HISTORY / HARNESS_STOP_SEQUENCE override these values.
#   generator=json - the model returns the JSON change-set object (current default)
#   generator=dsl  - the model returns one fenced Scratch-Python module, which the
#                    bridge transpiles into the same change set
#   history=on     - include acked turns in the prompt (default)
#   history=off    - stateless prompts, byte-identical to the pre-history bridge
#   stop_sequence=off - (dsl only) send a stop sequence after the closing fence,
#                       so the model cannot append prose; flip on only after a
#                       live ladder A/B shows the provider honours it without
#                       hurting prompt caching
#   eager_context=on  - include the AI-owned script bodies (within a budget)
#                       and the keyword-matched context packs on attempt 1,
#                       so revisions and game/clone/3D turns skip the
#                       load_sprite/load_context round trip and the replace
#                       echo (default on; HARNESS_EAGER_CONTEXT overrides)
# [harness]
# generator=json
# history=on
# stop_sequence=off
# eager_context=on

[profile:opencode-go]
# The verified live path (oc_sk_ key).
base_url=https://opencode.ai/inference/go/openai/v1
model=deepseek-v4.1-flash
api_key_env=DEEPSEEK_API_KEY
timeout=90
retries=2
thinking=off

[profile:deepseek-direct]
# A direct DeepSeek platform key.
base_url=https://api.deepseek.com
model=deepseek-chat
api_key_env=DEEPSEEK_API_KEY
timeout=90
retries=2
thinking=off

[profile:local]
# Ollama or any other OpenAI-compatible server on this machine.
base_url=http://127.0.0.1:11434/v1
model=qwen2.5-coder
api_key_env=LOCAL_API_KEY
timeout=120
retries=0
thinking=off
